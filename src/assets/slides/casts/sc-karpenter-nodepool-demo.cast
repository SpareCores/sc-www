[56.869, "m", "GILty on a hand-picked instance"]
[56.969, "o", "\u001b[1;32m$\u001b[0m "]
[57.349, "o", "k"]
[57.422, "o", "u"]
[57.459, "o", "b"]
[57.522, "o", "e"]
[57.614, "o", "c"]
[57.664, "o", "t"]
[57.729, "o", "l"]
[57.839, "o", " "]
[57.924, "o", "a"]
[57.995, "o", "p"]
[58.049, "o", "p"]
[58.131, "o", "l"]
[58.178, "o", "y"]
[58.233, "o", " "]
[58.301, "o", "-"]
[58.395, "o", "f"]
[58.51, "o", " "]
[58.551, "o", "-"]
[58.665, "o", " "]
[58.725, "o", "<"]
[58.8, "o", "<"]
[58.886, "o", "'"]
[58.928, "o", "E"]
[58.981, "o", "O"]
[59.038, "o", "F"]
[59.085, "o", "'"]
[59.396, "o", "\r\n"]
[60.008, "o", "> apiVersion: karpenter.sh/v1\r\n"]
[60.02, "o", "> kind: NodePool\r\n"]
[60.032, "o", "> metadata:\r\n"]
[60.044, "o", ">   name: python-apps\r\n"]
[60.056, "o", "> spec:\r\n"]
[60.068, "o", ">   template:\r\n"]
[60.08, "o", ">     spec:\r\n"]
[60.092, "o", ">       nodeClassRef: {group: eks.amazonaws.com, kind: NodeClass, name: default}\r\n"]
[60.104, "o", ">       requirements:\r\n"]
[60.116, "o", ">         - {key: node.kubernetes.io/instance-type, operator: In, values: [r5a.large]}\r\n"]
[60.128, "o", ">         - {key: karpenter.sh/capacity-type, operator: In, values: [on-demand]}\r\n"]
[60.14, "o", "> ---\r\n"]
[60.152, "o", "> apiVersion: apps/v1\r\n"]
[60.164, "o", "> kind: Deployment\r\n"]
[60.176, "o", "> metadata:\r\n"]
[60.188, "o", ">   name: gilty-handpicked\r\n"]
[60.2, "o", "> spec:\r\n"]
[60.212, "o", ">   selector: {matchLabels: {app: gilty, pool: python-apps}}\r\n"]
[60.224, "o", ">   template:\r\n"]
[60.236, "o", ">     metadata: {labels: {app: gilty, pool: python-apps}}\r\n"]
[60.248, "o", ">     spec:\r\n"]
[60.26, "o", ">       nodeSelector: {karpenter.sh/nodepool: python-apps}\r\n"]
[60.272, "o", ">       serviceAccountName: gilty      # may read its node: the instance type\r\n"]
[60.284, "o", ">       containers:\r\n"]
[60.296, "o", ">         - name: gilty\r\n"]
[60.308, "o", ">           image: ghcr.io/sparecores/gilty:0.2.1\r\n"]
[60.32, "o", ">           args: [--interval, \"5\"]\r\n"]
[60.332, "o", ">           env: [{name: NODE_NAME, valueFrom: {fieldRef: {fieldPath: spec.nodeName}}}]\r\n"]
[60.344, "o", ">           resources: {requests: {cpu: \"1\", memory: 512Mi}}\r\n"]
[60.356, "o", "> EOF\r\n"]
[61.356, "o", "nodepool.karpenter.sh/python-apps created\r\n"]
[61.639, "o", "deployment.apps/gilty-handpicked created\r\n"]
