[145.021, "o", "> apiVersion: apps/v1\r\n"]
[145.033, "o", "> kind: Deployment\r\n"]
[145.045, "o", "> metadata:\r\n"]
[145.057, "o", ">   name: gilty-sparecores\r\n"]
[145.069, "o", "> spec:\r\n"]
[145.081, "o", ">   selector: {matchLabels: {app: gilty, pool: gilty}}\r\n"]
[145.093, "o", ">   template:\r\n"]
[145.105, "o", ">     metadata: {labels: {app: gilty, pool: gilty}}\r\n"]
[145.117, "o", ">     spec:\r\n"]
[145.129, "o", ">       nodeSelector: {karpenter.sh/nodepool: gilty}\r\n"]
