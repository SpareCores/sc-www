[111.619, "o", "> apiVersion: karpenter.sparecores.com/v1alpha1\r\n"]
[111.631, "o", "> kind: SCNodePool\r\n"]
[111.643, "o", "> metadata:\r\n"]
[111.655, "o", ">   name: gilty\r\n"]
[111.667, "o", "> spec:\r\n"]
[111.679, "o", ">   nodePoolTemplate:\r\n"]
[111.691, "o", ">     spec:\r\n"]
[111.703, "o", ">       template:\r\n"]
[111.715, "o", ">         spec:\r\n"]
[111.727, "o", ">           nodeClassRef: {group: eks.amazonaws.com, kind: NodeClass, name: default}\r\n"]
[111.739, "o", ">           requirements:\r\n"]
[111.751, "o", ">             - {key: karpenter.sh/capacity-type, operator: In, values: [on-demand]}\r\n"]
[111.763, "o", ">   selector:\r\n"]
[111.775, "o", ">     vcpus: {min: 2}                        # at least what the r5a.large has:\r\n"]
[111.787, "o", ">     memory: {minGiB: 16}                   #   2 vCPUs, 16 GiB\r\n"]
[111.799, "o", ">     price: {maxHourly: \"0.1392\"}           # r5a.large + 10%, Auto Mode fee included\r\n"]
[111.811, "o", ">     families: {exclude: [\"t*\", \"*-flex\"]}  # no burstable or flex: GILty needs a full core\r\n"]
[111.823, "o", ">   ranking:\r\n"]
[111.835, "o", ">     score:\r\n"]
[111.847, "o", ">       benchmark: {id: \"passmark:cpu_single_threaded_test\"}  # tracks GILty's speed best\r\n"]
[111.859, "o", ">     objective: Score              # fastest first; the price cap keeps the budget\r\n"]
[111.871, "o", ">     band: {withinPercent: 10}     # within 10% of the fastest counts as equal: cheapest wins\r\n"]
[111.883, "o", ">     families: {min: 1, max: 3}    # keep 1 to 3 such families; never pad with slower ones\r\n"]
[111.895, "o", "> EOF\r\n"]
[112.895, "o", "scnodepool.karpenter.sparecores.com/gilty created\r\n"]
